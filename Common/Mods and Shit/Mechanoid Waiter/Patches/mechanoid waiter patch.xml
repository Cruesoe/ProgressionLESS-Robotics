<?xml version="1.0" encoding="utf-8" ?>
<Patch>   

    <!-- Replace the recipe's research field where it has one, so it never ends up with two -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/RecipeDef[defName="Waiter"]/researchPrerequisite</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/RecipeDef[defName="Waiter"]/researchPrerequisite</xpath>
            <value>
                <researchPrerequisite>Ferny_Surrogate</researchPrerequisite>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/RecipeDef[defName="Waiter"]</xpath>
            <value>
                <researchPrerequisite>Ferny_Surrogate</researchPrerequisite>
            </value>
        </nomatch>
    </Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="CashRegister_Mech"]/researchPrerequisites</xpath>
		<value>
        <researchPrerequisites>
			<li>Ferny_Surrogate</li>
        </researchPrerequisites>
		</value>
	</Operation>

</Patch>