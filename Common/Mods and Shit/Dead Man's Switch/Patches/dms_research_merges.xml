<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Defense Equipment into Military Equipment -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/*/researchPrerequisites/li[.="DMS_EquipmentAdvanced"] | Defs/*/recipeMaker/researchPrerequisites/li[.="DMS_EquipmentAdvanced"] | Defs/ResearchProjectDef/prerequisites/li[.="DMS_EquipmentAdvanced"] | Defs/Vehicles.UpgradeTreeDef/nodes/li/researchPrerequisites/li[.="DMS_EquipmentAdvanced"]</xpath>
        <value>
            <li>DMS_EquipmentElite</li>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/*/researchPrerequisite[.="DMS_EquipmentAdvanced"] | Defs/*/recipeMaker/researchPrerequisite[.="DMS_EquipmentAdvanced"]</xpath>
        <value>
            <researchPrerequisite>DMS_EquipmentElite</researchPrerequisite>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ScenarioDef/scenario/parts/li/project[.="DMS_EquipmentAdvanced"]</xpath>
        <value>
            <project>DMS_EquipmentElite</project>
        </value>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>Defs/ResearchProjectDef[defName="DMS_EquipmentAdvanced"]</xpath>
    </Operation>

