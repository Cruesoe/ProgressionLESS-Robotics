<?xml version="1.0" encoding="utf-8" ?>
<Patch>



<!-- Moving all of it up the tech tree -->

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="BasicMechtech"]/prerequisites</xpath>
    <value>
        <prerequisites>
            <li>MicroelectronicsBasics</li>
        </prerequisites>    
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="HighMechtech"]/prerequisites</xpath>
    <value>
        <prerequisites>
            <li>StandardMechtech</li>
        </prerequisites>    
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="UltraMechtech"]/prerequisites</xpath>
    <value>
        <prerequisites>
            <li>HighMechtech</li>
        </prerequisites>    
    </value>
</Operation>


<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[@Name="MechtechBase"]/techLevel</xpath>
    <value>
        <techLevel>Spacer</techLevel>    
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="BasicMechtech"]/label</xpath>
    <value>
        <label>Mechanoids</label>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="BasicMechtech"]/baseCost</xpath>
    <value>
        <baseCost>3000</baseCost>
    </value>
</Operation>

<Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[@Name="MechtechBase"]/requiresMechanitor</xpath>
</Operation>


<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="StandardMechtech"]/label</xpath>
    <value>
        <label>Large mechanoids</label>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="StandardMechtech"]/baseCost</xpath>
    <value>
        <baseCost>5000</baseCost>
    </value>
</Operation>


