<?xml version="1.0" encoding="utf-8" ?>
<Patch>   

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="VQE_UnfinishedDroneSpawner_AutobroadcasterDrone"]/label</xpath>
    <value>
        <label>deployed broadcaster drone</label>
    </value>
</Operation>

<!-- Autobroadcaster -> Broadcaster -->
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="VQE_AutobroadcasterDrone"]/label</xpath>
    <value>
        <label>broadcaster drone</label>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/PawnKindDef[defName="VQE_AutobroadcasterDrone"]/label</xpath>
    <value>
        <label>broadcaster drone</label>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/RecipeDef[defName="VQE_AssembleAutobroadcasterDrone"]/label</xpath>
    <value>
        <label>assemble broadcaster drone</label>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="VQE_UnfinishedDroneSpawner_AutobroadcasterDrone"]/label</xpath>
    <value>
        <label>deployed broadcaster drone</label>
    </value>
</Operation>








